# ========================================
# PRISM FRONTEND - CURRENT ENVIRONMENT
# ========================================
# For local development, point to local backend
# For production build, use .env.production or set in Netlify

# Backend API URL (local for development)
VITE_API_URL=http://localhost:4000

# Transmission encryption key (must match backend TRANSMISSION_KEY)
VITE_TRANSMISSION_KEY=prism-transmission-key-change-in-production-2026

# Environment
VITE_ENV=development
