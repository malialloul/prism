# ========================================
# PRISM FRONTEND CONFIGURATION
# ========================================
# Copy this file to .env and fill in your values
# Vite automatically loads .env.development or .env.production based on mode

# Backend API URL
# Development: http://localhost:4000
# Production: https://your-backend.onrender.com
VITE_API_URL=http://localhost:4000

# Transmission encryption key (must match backend TRANSMISSION_KEY)
VITE_TRANSMISSION_KEY=your-transmission-key-change-in-production

# Environment indicator (optional - for debugging)
VITE_ENV=development
