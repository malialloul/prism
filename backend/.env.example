# PostgreSQL Configuration
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_password
PG_DATABASE=your_database

# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=your_database

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Transmission encryption key (must match frontend VITE_TRANSMISSION_KEY)
TRANSMISSION_KEY=your-transmission-key-change-in-production

# AI Provider Configuration
# Options: 'gemini' (recommended for production) or 'ollama' (for local development)
AI_PROVIDER=gemini

# Gemini Configuration (free tier: 1500 requests/day)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Ollama Configuration (for local development)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
