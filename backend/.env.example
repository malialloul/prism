# ========================================
# PRISM BACKEND CONFIGURATION
# ========================================
# Copy this file to .env and fill in your values
# For environment-specific settings, see .env.development and .env.production

# Environment (development | production)
NODE_ENV=development

# PostgreSQL Configuration
# For production, use Neon: https://neon.tech
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_password
PG_DATABASE=prism_db
PG_SSL=false

# MySQL Configuration (optional - for hosted MySQL database creation)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password

# Server Configuration
PORT=4000

# JWT Configuration (use a strong secret in production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Transmission encryption key (must match frontend VITE_TRANSMISSION_KEY)
TRANSMISSION_KEY=your-transmission-key-change-in-production

# Neon API Configuration (for hosted PostgreSQL databases)
# Get API key from: https://console.neon.tech/app/settings/api-keys
# Get Org ID from: https://console.neon.tech/app/settings/organizations
NEON_API_KEY=
NEON_ORG_ID=

# Feature Flags
ENABLE_HOSTED_DBS=true
ENABLE_MYSQL_HOSTED=false

# AI Provider Configuration
# Options: 'gemini' (recommended for production) or 'ollama' (for local development)
AI_PROVIDER=gemini

# Gemini Configuration (free tier: 1500 requests/day)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Ollama Configuration (for local development)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# OAuth Configuration
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret