# ========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ========================================

# Environment
NODE_ENV=production

# PostgreSQL Configuration (Neon Production)
PG_HOST=your-neon-host.neon.tech
PG_PORT=5432
PG_USER=your_neon_user
PG_PASSWORD=your_neon_password
PG_DATABASE=neondb
PG_SSL=true

# MySQL Configuration (not available in free tier)
# MYSQL_HOST=
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=

# Server Configuration
PORT=4000

# JWT Configuration (use a strong, unique secret!)
JWT_SECRET=your-super-strong-production-jwt-secret-minimum-32-chars

# Transmission encryption key (must match frontend VITE_TRANSMISSION_KEY)
TRANSMISSION_KEY=your-super-strong-production-transmission-key

# Neon API (for hosted PostgreSQL databases)
# Get from: https://console.neon.tech/app/settings/api-keys
NEON_API_KEY=your_neon_api_key
NEON_ORG_ID=your_neon_org_id

# Feature Flags
ENABLE_HOSTED_DBS=true
ENABLE_MYSQL_HOSTED=false

# AI Provider Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# Security
DEBUG=false
