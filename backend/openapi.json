{
  "info": {
    "title": "Auth API",
    "version": "1.0.0",
    "description": "Authentication API for Cloud API Builder"
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Development server"
    }
  ],
  "openapi": "3.0.0",
  "components": {
    "schemas": {
      "SignupDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8
          },
          "fullName": {
            "type": "string",
            "minLength": 2
          }
        },
        "required": [
          "email",
          "password"
        ],
        "description": "Schema for user signup"
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "description": "Schema for user login"
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ],
        "description": "Schema for forgot password request"
      },
      "VerifyResetCodeDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "code"
        ],
        "description": "Schema for verifying reset code"
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "code": {
            "type": "string"
          },
          "newPassword": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "email",
          "code",
          "newPassword"
        ],
        "description": "Schema for resetting password"
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "description": "Schema for changing password (authenticated)"
      },
      "ChangeEmailDto": {
        "type": "object",
        "properties": {
          "newEmail": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "newEmail",
          "password"
        ],
        "description": "Schema for changing email (authenticated)"
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "fullName": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "createdAt",
          "updatedAt"
        ],
        "description": "User data transfer object"
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "error",
              "fail"
            ]
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "token": {
                "type": "string"
              }
            },
            "required": [
              "token"
            ]
          }
        },
        "required": [
          "status",
          "message"
        ],
        "description": "Authentication response with token"
      },
      "TokenResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "error",
              "fail"
            ]
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "token": {
                "type": "string"
              }
            },
            "required": [
              "token"
            ]
          }
        },
        "required": [
          "status",
          "message"
        ],
        "description": "JWT token response"
      },
      "PasswordActionResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "error",
              "fail"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "message"
        ],
        "description": "Password action response"
      },
      "ChangeEmailResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "error",
              "fail"
            ]
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "token": {
                "type": "string"
              }
            },
            "required": [
              "token"
            ]
          }
        },
        "required": [
          "status",
          "message"
        ],
        "description": "Change email response with new token"
      },
      "Setup2FADto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "description": "Schema for setting up 2FA"
      },
      "Verify2FADto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "description": "Schema for verifying 2FA code"
      },
      "Disable2FADto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "password",
          "code"
        ],
        "description": "Schema for disabling 2FA"
      },
      "Login2FADto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "code": {
            "type": "string"
          },
          "tempToken": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "code",
          "tempToken"
        ],
        "description": "Schema for 2FA login verification"
      },
      "TwoFactorStatusResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "error",
              "fail"
            ]
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              }
            },
            "required": [
              "enabled"
            ]
          }
        },
        "required": [
          "status",
          "message"
        ],
        "description": "2FA status response"
      },
      "Setup2FAResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "error",
              "fail"
            ]
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "qrCode": {
                "type": "string"
              },
              "secret": {
                "type": "string"
              }
            },
            "required": [
              "qrCode",
              "secret"
            ]
          }
        },
        "required": [
          "status",
          "message"
        ],
        "description": "2FA setup response with QR code"
      },
      "Verify2FAResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "error",
              "fail"
            ]
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "backupCodes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "backupCodes"
            ]
          }
        },
        "required": [
          "status",
          "message"
        ],
        "description": "2FA verification response with backup codes"
      },
      "Login2FARequiredResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "error",
              "fail"
            ]
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "requires2FA": {
                "type": "boolean"
              },
              "tempToken": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            },
            "required": [
              "requires2FA",
              "tempToken",
              "email"
            ]
          }
        },
        "required": [
          "status",
          "message"
        ],
        "description": "Login response when 2FA is required"
      },
      "VerifyCodeResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "error",
              "fail"
            ]
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "valid": {
                "type": "boolean"
              }
            },
            "required": [
              "valid"
            ]
          }
        },
        "required": [
          "status",
          "message"
        ],
        "description": "Verify code response"
      }
    },
    "parameters": {}
  },
  "paths": {
    "/auth/signup": {
      "post": {
        "summary": "Create a new user account",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          },
          "409": {
            "description": "User already exists"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Authenticate user and get JWT token",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "summary": "Request password reset code",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reset code sent if email exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordActionResponseDto"
                }
              }
            }
          }
        }
      }
    },
    "/auth/verify-reset-code": {
      "post": {
        "summary": "Verify password reset code",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyResetCodeDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Code verification result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyCodeResponseDto"
                }
              }
            }
          }
        }
      }
    },
    "/auth/reset-password": {
      "post": {
        "summary": "Reset password with valid code",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordActionResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or expired code"
          }
        }
      }
    },
    "/auth/change-password": {
      "post": {
        "summary": "Change password for authenticated user",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password changed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordActionResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized or incorrect current password"
          }
        }
      }
    },
    "/auth/change-email": {
      "post": {
        "summary": "Change email for authenticated user",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeEmailDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email changed successfully, returns new token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangeEmailResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized or incorrect password"
          },
          "409": {
            "description": "Email already exists"
          }
        }
      }
    },
    "/auth/2fa/status": {
      "get": {
        "summary": "Get 2FA status for authenticated user",
        "tags": [
          "Two-Factor Authentication"
        ],
        "responses": {
          "200": {
            "description": "2FA status retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TwoFactorStatusResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/auth/2fa/setup": {
      "post": {
        "summary": "Setup 2FA for authenticated user",
        "tags": [
          "Two-Factor Authentication"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Setup2FADto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "2FA setup initiated, returns QR code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Setup2FAResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "2FA already enabled or invalid password"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/auth/2fa/verify": {
      "post": {
        "summary": "Verify 2FA code and enable 2FA",
        "tags": [
          "Two-Factor Authentication"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Verify2FADto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "2FA enabled successfully, returns backup codes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Verify2FAResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid verification code"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/auth/2fa/disable": {
      "post": {
        "summary": "Disable 2FA for authenticated user",
        "tags": [
          "Two-Factor Authentication"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Disable2FADto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "2FA disabled successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordActionResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid password or code"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/auth/login/2fa": {
      "post": {
        "summary": "Complete login with 2FA code",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login2FADto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid verification code"
          },
          "401": {
            "description": "Invalid or expired session"
          }
        }
      }
    }
  }
}
