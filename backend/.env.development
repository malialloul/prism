# ========================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# ========================================

# Environment
NODE_ENV=development

# PostgreSQL Configuration (Local or Neon Dev)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_password
PG_DATABASE=prism_dev
PG_SSL=false

# MySQL Configuration (for hosted MySQL database creation)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=mysql

# Server Configuration
PORT=4000

# JWT Configuration
JWT_SECRET=dev-secret-key-change-for-production

# Transmission encryption key (must match frontend VITE_TRANSMISSION_KEY)
TRANSMISSION_KEY=dev-transmission-key-change-for-production

# Neon API (for hosted PostgreSQL databases)
# Get from: https://console.neon.tech/app/settings/api-keys
NEON_API_KEY=
NEON_ORG_ID=

# Feature Flags
ENABLE_HOSTED_DBS=true
ENABLE_MYSQL_HOSTED=false

# AI Provider Configuration
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Debug
DEBUG=true
